{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codewalk.parser.ir/1",
  "title": "Codewalk shared parser IR",
  "description": "Portable parser contract normalized from language adapter outputs.",
  "type": "object",
  "required": [
    "contract",
    "schema_version",
    "engine",
    "repository",
    "coordinates",
    "translation",
    "packages",
    "projects",
    "files",
    "nodes",
    "relationships",
    "occurrences",
    "diagnostics",
    "analysis",
    "stats"
  ],
  "properties": {
    "contract": { "const": "codewalk.parser.ir/1" },
    "schema_version": { "const": 1 },
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string" }
      },
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "required": ["root", "id", "source_roots", "package_roots", "project_roots"],
      "properties": {
        "root": { "const": "." },
        "id": { "type": "string", "minLength": 1 },
        "source_roots": { "type": "array", "items": { "type": "string" } },
        "package_roots": { "type": "array", "items": { "type": "string" } },
        "project_roots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "coordinates": {
      "type": "object",
      "required": ["line_base", "column_base", "offset_unit", "policy"],
      "properties": {
        "line_base": { "const": 1 },
        "column_base": { "const": 0 },
        "offset_unit": { "const": "native-per-file" },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "translation": {
      "type": "object",
      "required": ["adapter", "preserved_native_kinds", "category_kinds", "translation_gaps"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "preserved_native_kinds": { "type": "array", "items": { "type": "string" } },
        "category_kinds": { "type": "array", "items": { "enum": ["requires", "calls", "mentions"] } },
        "translation_gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "packages": { "type": "array" },
    "projects": { "type": "array" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status", "coordinates"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["present", "deleted", "invalid"] },
          "coordinates": { "type": "object" }
        }
      }
    },
    "nodes": { "type": "array" },
    "relationships": { "type": "array" },
    "occurrences": { "type": "array" },
    "diagnostics": { "type": "array" },
    "analysis": {
      "type": "object",
      "required": [
        "mode",
        "invocation_status",
        "result_status",
        "fatal",
        "changed_files",
        "deleted_files",
        "invalidated_files",
        "ownership"
      ],
      "properties": {
        "mode": { "enum": ["full", "incremental"] },
        "invocation_status": { "enum": ["success", "fatal"] },
        "result_status": { "enum": ["complete", "partial", "fatal"] },
        "fatal": { "type": "boolean" },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "deleted_files": { "type": "array", "items": { "type": "string" } },
        "invalidated_files": { "type": "array", "items": { "type": "string" } },
        "ownership": { "type": "array" }
      }
    },
    "stats": { "type": "object" }
  },
  "additionalProperties": false
}
